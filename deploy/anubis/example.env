# Public hostname routed to this gateway. Do not include https://.
PUBLIC_DOMAIN=app.example.com
# HTTPS deployment URL of the Vercel app, not the public gateway domain.
VERCEL_ORIGIN=https://your-project.vercel.app
# Generate independently with: openssl rand -hex 32
ANUBIS_SIGNING_KEY=replace-with-64-hex-characters
# Generate independently with: openssl rand -hex 32
ANUBIS_ORIGIN_SECRET=replace-with-a-different-random-secret
