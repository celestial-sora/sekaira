# Copy to .env.local. Never put secrets in NEXT_PUBLIC variables.
GROQ_API_KEY=
# Optional web research for canon character and world generation.
TAVILY_API_KEY=
# Optional override. The code default is in src/lib/llm.ts.
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
# Optional: when using the Anubis gateway, use the same secret as deploy/anubis/.env.
# Set this in Vercel only after the gateway is reachable. Direct origin requests then return 403.
ANUBIS_ORIGIN_SECRET=
# Comma-separated Google account emails allowed to use admin APIs. Production fails closed when empty.
ADMIN_EMAILS=
# Supabase transaction-pooler URL for Vercel; do not commit the password.
DATABASE_URL=
# Explicitly local development only. Guest mode is disabled in production.
ALLOW_GUEST=true
